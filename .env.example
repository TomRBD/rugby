# Connexion administrateur (migrations, worker)
DATABASE_URL=postgres://rugby_admin:rugby_admin@localhost:5433/rugby
# Connexion applicative (rôle sans privilège, soumis aux politiques RLS multi-tenant)
APP_DATABASE_URL=postgres://rugby_app:rugby_app@localhost:5433/rugby
# Secret de signature des jetons (JWT et URLs média). A changer en production.
APP_SECRET=change-moi-en-production-avec-32-caracteres-minimum
# Stockage vidéo : "local" (dossier) ou "s3" (Scaleway, OVHcloud, MinIO...)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=rugby-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Worker de transcodage : nombre de jobs FFmpeg en parallèle
WORKER_CONCURRENCY=4
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# URL publique du front (liens de partage)
PUBLIC_WEB_URL=http://localhost:5173
API_PORT=3000
